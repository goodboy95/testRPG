{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://town-rpg.local/schemas/protagonist-art-pass-v2-manifest.schema.json",
  "title": "town-rpg protagonist static art pass v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestSchema",
    "assetId",
    "assetStage",
    "visualCandidate",
    "visualApprovalStatus",
    "runtimeReady",
    "sourceAuthority",
    "sourceFile",
    "runtimeCandidateFile",
    "sourceSha256",
    "runtimeSha256",
    "runtimeBytes",
    "blenderVersion",
    "bound",
    "animated",
    "heightMeters",
    "worldBoundsMeters",
    "requiredCollections",
    "requiredObjects",
    "exportedObjects",
    "majorVisibleMeshCount",
    "triangleCount",
    "materialSurfaceCount",
    "materialNames",
    "topology",
    "textures",
    "runtimeInspection",
    "missingExternalFiles",
    "anchorsMeters",
    "limits",
    "exportProfile"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "manifestSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "const": "scripts/tools/schemas/protagonist-art-pass-v2-manifest.schema.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assetId": {
      "type": "string",
      "const": "protagonist.art_pass_v2"
    },
    "assetStage": {
      "type": "string",
      "const": "static-visual-candidate"
    },
    "visualCandidate": {
      "type": "boolean",
      "const": true
    },
    "visualApprovalStatus": {
      "type": "string",
      "const": "pending"
    },
    "runtimeReady": {
      "type": "boolean",
      "const": false
    },
    "sourceAuthority": {
      "type": "string",
      "const": "blend"
    },
    "sourceFile": {
      "type": "string",
      "const": "art/blender/characters/protagonist-art-pass-v2.blend"
    },
    "runtimeCandidateFile": {
      "type": "string",
      "const": "assets/generated/characters/3d/protagonist-art-pass-v2.glb"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20971520
    },
    "blenderVersion": {
      "type": "string",
      "minLength": 5
    },
    "bound": {
      "type": "boolean",
      "const": false
    },
    "animated": {
      "type": "boolean",
      "const": false
    },
    "heightMeters": {
      "type": "number",
      "minimum": 1.67,
      "maximum": 1.71
    },
    "worldBoundsMeters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "maximum": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        }
      }
    },
    "requiredCollections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requiredObjects": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "exportedObjects": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "majorVisibleMeshCount": {
      "type": "integer",
      "const": 6
    },
    "triangleCount": {
      "type": "integer",
      "minimum": 30000,
      "maximum": 36000
    },
    "materialSurfaceCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "materialNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meshReports",
        "boundaryEdgeCount",
        "nonManifoldEdgeCount",
        "looseEdgeCount",
        "looseVertexCount",
        "zeroAreaFaceCount",
        "closedComponentCount",
        "minimumSignedComponentVolumeMeters3"
      ],
      "properties": {
        "meshReports": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "vertexCount",
              "polygonCount",
              "triangleCount",
              "boundaryEdgeCount",
              "nonManifoldEdgeCount",
              "looseEdgeCount",
              "looseVertexCount",
              "zeroAreaFaceCount",
              "closedComponentCount",
              "minimumSignedComponentVolumeMeters3",
              "uvLayer",
              "materialNames"
            ],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "vertexCount": {"type": "integer", "minimum": 1},
              "polygonCount": {"type": "integer", "minimum": 1},
              "triangleCount": {"type": "integer", "minimum": 1},
              "boundaryEdgeCount": {"type": "integer", "const": 0},
              "nonManifoldEdgeCount": {"type": "integer", "const": 0},
              "looseEdgeCount": {"type": "integer", "const": 0},
              "looseVertexCount": {"type": "integer", "const": 0},
              "zeroAreaFaceCount": {"type": "integer", "const": 0},
              "closedComponentCount": {"type": "integer", "minimum": 1},
              "minimumSignedComponentVolumeMeters3": {
                "type": "number",
                "minimum": 1e-12
              },
              "uvLayer": {"type": "string", "minLength": 1},
              "materialNames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "boundaryEdgeCount": {"type": "integer", "const": 0},
        "nonManifoldEdgeCount": {"type": "integer", "const": 0},
        "looseEdgeCount": {"type": "integer", "const": 0},
        "looseVertexCount": {"type": "integer", "const": 0},
        "zeroAreaFaceCount": {"type": "integer", "const": 0},
        "closedComponentCount": {"type": "integer", "minimum": 6},
        "minimumSignedComponentVolumeMeters3": {
          "type": "number",
          "minimum": 1e-12
        }
      }
    },
    "textures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256",
          "width",
          "height",
          "bitDepth",
          "colorType",
          "channels",
          "pixelFormat",
          "colorSpace",
          "usedByMaterials"
        ],
        "properties": {
          "role": {"type": "string", "enum": ["albedo", "normal", "orm"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "width": {"type": "integer", "const": 2048},
          "height": {"type": "integer", "const": 2048},
          "bitDepth": {"type": "integer", "const": 8},
          "colorType": {"type": "integer", "const": 6},
          "channels": {"type": "integer", "const": 4},
          "pixelFormat": {"type": "string", "const": "RGBA"},
          "colorSpace": {"type": "string", "enum": ["sRGB", "Non-Color"]},
          "usedByMaterials": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "runtimeInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glbVersion",
        "nodeNames",
        "meshCount",
        "triangleCount",
        "materialCount",
        "materialNames",
        "embeddedImages",
        "skinCount",
        "animationCount",
        "cameraCount"
      ],
      "properties": {
        "glbVersion": {"type": "integer", "const": 2},
        "nodeNames": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "meshCount": {"type": "integer", "const": 6},
        "triangleCount": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 36000
        },
        "materialCount": {"type": "integer", "minimum": 1, "maximum": 5},
        "materialNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "embeddedImages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "name", "mimeType", "byteLength", "sha256"],
            "properties": {
              "role": {"type": "string", "enum": ["albedo", "normal", "orm"]},
              "name": {"type": "string"},
              "mimeType": {"type": "string", "const": "image/png"},
              "byteLength": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "skinCount": {"type": "integer", "const": 0},
        "animationCount": {"type": "integer", "const": 0},
        "cameraCount": {"type": "integer", "const": 0}
      }
    },
    "missingExternalFiles": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string"}
    },
    "anchorsMeters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "feet"],
      "properties": {
        "head": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "feet": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heightMeters",
        "triangles",
        "majorVisibleMeshes",
        "materialSurfaces",
        "textureSize",
        "runtimeBytes"
      ],
      "properties": {
        "heightMeters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "triangles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer"}
        },
        "majorVisibleMeshes": {"type": "integer", "const": 6},
        "materialSurfaces": {"type": "integer", "const": 5},
        "textureSize": {"type": "integer", "const": 2048},
        "runtimeBytes": {"type": "integer", "const": 20971520}
      }
    },
    "exportProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "appliedModifiers",
        "animations",
        "armature",
        "cameras",
        "lights",
        "tangents",
        "textures"
      ],
      "properties": {
        "format": {"type": "string", "const": "GLB"},
        "appliedModifiers": {"type": "boolean", "const": true},
        "animations": {"type": "boolean", "const": false},
        "armature": {"type": "boolean", "const": false},
        "cameras": {"type": "boolean", "const": false},
        "lights": {"type": "boolean", "const": false},
        "tangents": {"type": "string", "const": "generated-by-godot-import"},
        "textures": {"type": "string", "const": "embedded-from-tracked-2k-rgba-png"}
      }
    }
  }
}
