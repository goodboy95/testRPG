; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="雾山旧轨"
run/main_scene="res://scenes/app/Main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameSession="*res://scripts/application/GameSession.cs"
Narrative="*res://scripts/application/NarrativeBridge.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="TownRpg"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

