[internationalization]

locale/translations=PackedStringArray("res://localization/zh_CN.zh_CN.translation")
locale/translations_pot_files=PackedStringArray("res://dialogue/events/evt_d1_activity_shen.dialogue", "res://dialogue/events/evt_d1_activity_xiaoyu.dialogue", "res://dialogue/events/evt_d1_activity_zhou.dialogue", "res://dialogue/events/evt_d1_four_way_reunion.dialogue", "res://dialogue/events/evt_d1_promise.dialogue", "res://dialogue/events/evt_d1_wakeup.dialogue", "res://dialogue/events/evt_d2_first_anomaly.dialogue", "res://dialogue/events/evt_d2_railway_notice.dialogue", "res://dialogue/events/evt_dream_calibration.dialogue", "res://dialogue/events/evt_dream_handoff.dialogue", "res://dialogue/events/evt_dream_intro.dialogue", "res://dialogue/events/evt_dream_meeting.dialogue", "res://dialogue/events/evt_dream_morning.dialogue", "res://dialogue/events/evt_dream_photo.dialogue", "res://dialogue/events/evt_dream_programme.dialogue", "res://dialogue/events/evt_dream_registry.dialogue", "res://dialogue/events/evt_dream_score.dialogue", "res://dialogue/events/evt_dream_stage.dialogue", "res://dialogue/events/evt_dream_tape.dialogue", "res://dialogue/events/evt_dream_timeline.dialogue", "res://dialogue/events/evt_dream_window.dialogue")
