<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TownRpg</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);work/**;outputs/**;.godot/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="src/TownRpg.Core/TownRpg.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="src/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="work/**/*.cs" />
    <Compile Remove="outputs/**/*.cs" />
    <Compile Remove="addons/dialogue_manager/example_balloon/**/*.cs" />
  </ItemGroup>
</Project>
